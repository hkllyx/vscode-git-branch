{
  "name": "git-branch",
  "displayName": "Git Branch",
  "description": "Branch management in Source Control: checkout, create, compare, rename, merge, rebase and delete branches.",
  "version": "0.1.0",
  "publisher": "hkllyx",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["SCM Providers"],
  "main": "./src/extension.js",
  "extensionKind": ["workspace"],
  "extensionDependencies": ["vscode.git"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/git-operations.js"
  },
  "contributes": {
    "commands": [
      { "command": "git-branch.refresh", "title": "Refresh Branches", "category": "Git Branch", "icon": "$(refresh)" },
      { "command": "git-branch.create", "title": "Create Branch...", "category": "Git Branch", "icon": "$(add)" },
      { "command": "git-branch.checkout", "title": "Checkout", "category": "Git Branch" },
      { "command": "git-branch.compare", "title": "Compare with Current", "category": "Git Branch" },
      { "command": "git-branch.rename", "title": "Rename Branch...", "category": "Git Branch" },
      { "command": "git-branch.merge", "title": "Merge into Current", "category": "Git Branch" },
      { "command": "git-branch.rebase", "title": "Rebase Current onto...", "category": "Git Branch" },
      { "command": "git-branch.delete", "title": "Delete Branch", "category": "Git Branch" },
      { "command": "git-branch.clearComparison", "title": "Clear Comparison", "category": "Git Branch", "icon": "$(close)" }
    ],
    "views": {
      "scm": [
        { "id": "git-branch.branches", "name": "Branches" },
        { "id": "git-branch.comparison", "name": "Branch Comparison", "when": "git-branch.hasComparison" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "git-branch.refresh", "when": "view == git-branch.branches", "group": "navigation@1" },
        { "command": "git-branch.create", "when": "view == git-branch.branches", "group": "navigation@2" },
        { "command": "git-branch.clearComparison", "when": "view == git-branch.comparison", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "git-branch.checkout", "when": "view == git-branch.branches && (viewItem == gb-local || viewItem == gb-remote)", "group": "1_actions@1" },
        { "command": "git-branch.create", "when": "view == git-branch.branches", "group": "1_actions@2" },
        { "command": "git-branch.merge", "when": "view == git-branch.branches && (viewItem == gb-local || viewItem == gb-remote)", "group": "2_merge@1" },
        { "command": "git-branch.rebase", "when": "view == git-branch.branches && (viewItem == gb-local || viewItem == gb-remote)", "group": "2_merge@2" },
        { "command": "git-branch.compare", "when": "view == git-branch.branches && viewItem =~ /^gb-(local|current|remote)$/", "group": "3_compare@1" },
        { "command": "git-branch.rename", "when": "view == git-branch.branches && (viewItem == gb-local || viewItem == gb-current)", "group": "4_branch@1" },
        { "command": "git-branch.delete", "when": "view == git-branch.branches && viewItem == gb-local", "group": "4_branch@2" }
      ]
    }
  }
}
