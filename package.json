      ],
      "git-branch.sortCompare": [
        { "command": "git-branch.groupSortOpened", "when": "viewItem =~ /^gb-comparisons-group/ && !(viewItem =~ /-sort-opened$/)", "group": "1@1" },
        { "command": "git-branch.groupSortOpened.current", "when": "viewItem =~ /^gb-comparisons-group/ && viewItem =~ /-sort-opened$/", "group": "1@1" },
        { "command": "git-branch.groupSortName", "when": "viewItem =~ /^gb-comparisons-group/ && !(viewItem =~ /-sort-name$/)", "group": "1@2" },
        { "command": "git-branch.groupSortName.current", "when": "viewItem =~ /^gb-comparisons-group/ && viewItem =~ /-sort-name$/", "group": "1@2" }
      ],
      "git-branch.diffMore": [
        { "command": "git-branch.diffList", "when": "!(viewItem =~ /-session-list-/)", "group": "1_view@1" },
        { "command": "git-branch.diffList.current", "when": "viewItem =~ /-session-list-/", "group": "1_view@1" },
        { "command": "git-branch.diffTree", "when": "!(viewItem =~ /-session-tree-/)", "group": "1_view@2" },
        { "command": "git-branch.diffTree.current", "when": "viewItem =~ /-session-tree-/", "group": "1_view@2" },
        { "command": "git-branch.diffSortName", "when": "!(viewItem =~ /-name$/)", "group": "2_sort@1" },
        { "command": "git-branch.diffSortName.current", "when": "viewItem =~ /-name$/", "group": "2_sort@1" },
        { "command": "git-branch.diffSortPath", "when": "!(viewItem =~ /-path$/)", "group": "2_sort@2" },
        { "command": "git-branch.diffSortPath.current", "when": "viewItem =~ /-path$/", "group": "2_sort@2" },
        { "command": "git-branch.diffSortStatus", "when": "!(viewItem =~ /-status$/)", "group": "2_sort@3" },
        { "command": "git-branch.diffSortStatus.current", "when": "viewItem =~ /-status$/", "group": "2_sort@3" }
      ],
      "commandPalette": [
