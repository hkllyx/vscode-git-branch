{
  "name": "git-branch",
  "displayName": "Git Branch",
  "description": "%extension.description%",
  "version": "2.0.0",
  "publisher": "hkllyx",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["SCM Providers", "Visualization"],
  "main": "./src/extension.js",
  "extensionKind": ["workspace"],
  "extensionDependencies": ["vscode.git"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "activationEvents": ["onView:git-branch.branches", "onView:git-branch.log"],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "package": "node package-vsix.js"
  },
  "contributes": {
    "commands": [
      { "command": "git-branch.refresh", "title": "%command.refresh%", "category": "Git Branch", "icon": "$(refresh)" },
      { "command": "git-branch.showTags", "title": "%command.showTags%", "category": "Git Branch" },
      { "command": "git-branch.hideTags", "title": "%command.hideTags%", "category": "Git Branch" },
      { "command": "git-branch.selectRepository", "title": "%command.selectRepository%", "category": "Git Branch", "icon": "$(repo)" },
      { "command": "git-branch.openLog", "title": "%command.openLog%", "category": "Git Branch" },
      { "command": "git-branch.openHistory", "title": "%command.openHistory%", "category": "Git Branch" },
      { "command": "git-branch.createFrom", "title": "%command.createFrom%", "category": "Git Branch" },
      { "command": "git-branch.checkout", "title": "%command.checkout%", "category": "Git Branch" },
      { "command": "git-branch.checkoutRemote", "title": "%command.checkoutRemote%", "category": "Git Branch" },
      { "command": "git-branch.checkoutUpdate", "title": "%command.checkoutUpdate%", "category": "Git Branch" },
      { "command": "git-branch.pull", "title": "%command.pull%", "category": "Git Branch" },
      { "command": "git-branch.push", "title": "%command.push%", "category": "Git Branch" },
      { "command": "git-branch.compareWithCurrent", "title": "%command.compareWithCurrent%", "category": "Git Branch" },
      { "command": "git-branch.compareWith", "title": "%command.compareWith%", "category": "Git Branch" },
      { "command": "git-branch.compareWorktree", "title": "%command.compareWorktree%", "category": "Git Branch" },
      { "command": "git-branch.mergeIntoCurrent", "title": "%command.mergeIntoCurrent%", "category": "Git Branch" },
      { "command": "git-branch.rebaseCurrent", "title": "%command.rebaseCurrent%", "category": "Git Branch" },
      { "command": "git-branch.newWorktree", "title": "%command.newWorktree%", "category": "Git Branch" },
      { "command": "git-branch.pullMerge", "title": "%command.pullMerge%", "category": "Git Branch" },
      { "command": "git-branch.pullRebase", "title": "%command.pullRebase%", "category": "Git Branch" },
      { "command": "git-branch.copyBranchName", "title": "%command.copyBranchName%", "category": "Git Branch" },
      { "command": "git-branch.renameBranch", "title": "%command.renameBranch%", "category": "Git Branch" },
      { "command": "git-branch.deleteBranch", "title": "%command.deleteBranch%", "category": "Git Branch" },
      { "command": "git-branch.compare", "title": "%command.compare%", "category": "Git Branch" },
      { "command": "git-branch.copyRevision", "title": "%command.copyRevision%", "category": "Git Branch" },
      { "command": "git-branch.cherryPick", "title": "%command.cherryPick%", "category": "Git Branch", "enablement": "gbCanPick" },
      { "command": "git-branch.checkoutRevision", "title": "%command.checkoutRevision%", "category": "Git Branch", "enablement": "gbCommitSingle" },
      { "command": "git-branch.compareLocal", "title": "%command.compareLocal%", "category": "Git Branch", "enablement": "gbCommitSingle" },
      { "command": "git-branch.reset", "title": "%command.reset%", "category": "Git Branch", "enablement": "gbCanReset" },
      { "command": "git-branch.revert", "title": "%command.revert%", "category": "Git Branch", "enablement": "gbCanRevert" },
      { "command": "git-branch.undo", "title": "%command.undo%", "category": "Git Branch", "enablement": "gbCanUndo" },
      { "command": "git-branch.editMessage", "title": "%command.editMessage%", "category": "Git Branch", "enablement": "gbCanRewrite" },
      { "command": "git-branch.squash", "title": "%command.squash%", "category": "Git Branch", "enablement": "gbCanRewrite" },
      { "command": "git-branch.drop", "title": "%command.drop%", "category": "Git Branch", "enablement": "gbCanDrop" },
      { "command": "git-branch.newBranch", "title": "%command.newBranch%", "category": "Git Branch", "enablement": "gbCommitSingle" },
      { "command": "git-branch.newTag", "title": "%command.newTag%", "category": "Git Branch", "enablement": "gbCommitSingle" },
      { "command": "git-branch.showDiff", "title": "%command.showDiff%", "category": "Git Branch", "enablement": "gbCanShowDiff" },
      { "command": "git-branch.editSource", "title": "%command.editSource%", "category": "Git Branch", "enablement": "gbCanEditSource" },
      { "command": "git-branch.openRepositoryVersion", "title": "%command.openRepositoryVersion%", "category": "Git Branch", "enablement": "gbCanOpenVersion" },
      { "command": "git-branch.applyFiles", "title": "%command.applyFiles%", "category": "Git Branch", "enablement": "gbCanApplyFiles" }
    ],
    "viewsContainers": {
      "panel": [{ "id": "git-branch-history", "title": "%view.history%", "icon": "$(history)" }]
    },
    "views": {
      "scm": [{ "id": "git-branch.branches", "name": "%view.branches%" }],
      "git-branch-history": [{ "id": "git-branch.log", "name": "%view.history%", "type": "webview" }]
    },
    "menus": {
      "view/title": [
        { "command": "git-branch.selectRepository", "when": "view == git-branch.branches && git-branch.hasMultipleRepositories", "group": "navigation@1" },
        { "command": "git-branch.refresh", "when": "view == git-branch.branches", "group": "navigation@2" },
        { "command": "git-branch.showTags", "when": "view == git-branch.branches && !git-branch.tagsVisible", "group": "2_history@1" },
        { "command": "git-branch.hideTags", "when": "view == git-branch.branches && git-branch.tagsVisible", "group": "2_history@1" },
        { "command": "git-branch.openLog", "when": "view == git-branch.branches", "group": "2_history@2" },
        { "command": "git-branch.compare", "when": "view == git-branch.branches", "group": "2_history@3" }
      ],
      "view/item/context": [
        { "command": "git-branch.openHistory", "when": "view == git-branch.branches && viewItem =~ /^gb-(head|current|local|remote|tag)$/", "group": "1_history@1" },
        { "command": "git-branch.checkout", "when": "view == git-branch.branches && viewItem == gb-local", "group": "2_branch@1" },
        { "command": "git-branch.checkoutRemote", "when": "view == git-branch.branches && viewItem == gb-remote", "group": "2_branch@1" },
        { "command": "git-branch.createFrom", "when": "view == git-branch.branches && viewItem =~ /^gb-(current|local|remote)$/", "group": "2_branch@2" },
        { "command": "git-branch.checkoutUpdate", "when": "view == git-branch.branches && viewItem == gb-local", "group": "2_branch@3" },
        { "command": "git-branch.compareWithCurrent", "when": "view == git-branch.branches && viewItem =~ /^gb-(local|remote)$/", "group": "4_compare@1" },
        { "command": "git-branch.compareWith", "when": "view == git-branch.branches && viewItem =~ /^gb-(current|local|remote)$/", "group": "4_compare@2" },
        { "command": "git-branch.compareWorktree", "when": "view == git-branch.branches && viewItem =~ /^gb-(current|local|remote)$/", "group": "4_compare@3" },
        { "command": "git-branch.mergeIntoCurrent", "when": "view == git-branch.branches && viewItem =~ /^gb-(local|remote)$/", "group": "5_integrate@1" },
        { "command": "git-branch.rebaseCurrent", "when": "view == git-branch.branches && viewItem =~ /^gb-(local|remote)$/", "group": "5_integrate@2" },
        { "command": "git-branch.newWorktree", "when": "view == git-branch.branches && viewItem =~ /^gb-(current|local|remote)$/", "group": "6_worktree@1" },
        { "command": "git-branch.pull", "when": "view == git-branch.branches && viewItem =~ /^gb-(current|local)$/", "group": "7_sync@1" },
        { "command": "git-branch.push", "when": "view == git-branch.branches && viewItem =~ /^gb-(current|local)$/", "group": "7_sync@2" },
        { "command": "git-branch.pullMerge", "when": "view == git-branch.branches && viewItem == gb-remote", "group": "7_sync@3" },
        { "command": "git-branch.pullRebase", "when": "view == git-branch.branches && viewItem == gb-remote", "group": "7_sync@4" },
        { "command": "git-branch.copyBranchName", "when": "view == git-branch.branches && viewItem =~ /^gb-(current|local|remote)$/", "group": "8_manage@1" },
        { "command": "git-branch.renameBranch", "when": "view == git-branch.branches && viewItem =~ /^gb-(current|local)$/", "group": "8_manage@2" },
        { "command": "git-branch.deleteBranch", "when": "view == git-branch.branches && viewItem =~ /^gb-(local|remote)$/", "group": "8_manage@3" }
      ],
      "webview/context": [
        { "command": "git-branch.copyRevision", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "1_revision@1" },
        { "command": "git-branch.cherryPick", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "2_operations@1" },
        { "command": "git-branch.checkoutRevision", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "2_operations@2" },
        { "command": "git-branch.compareLocal", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "2_operations@3" },
        { "command": "git-branch.reset", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "3_history@1" },
        { "command": "git-branch.revert", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "3_history@2" },
        { "command": "git-branch.undo", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "3_history@3" },
        { "command": "git-branch.editMessage", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "3_history@4" },
        { "command": "git-branch.squash", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "3_history@5" },
        { "command": "git-branch.drop", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "3_history@6" },
        { "command": "git-branch.newBranch", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "4_refs@1" },
        { "command": "git-branch.newTag", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == commit", "group": "4_refs@2" },
        { "command": "git-branch.showDiff", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == file", "group": "1_files@0" },
        { "command": "git-branch.editSource", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == file", "group": "1_files@1" },
        { "command": "git-branch.openRepositoryVersion", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == file", "group": "1_files@2" },
        { "command": "git-branch.applyFiles", "when": "(webview == git-branch.log || webviewId == git-branch.log) && gbArea == file", "group": "1_files@3" }
      ],
      "commandPalette": [
        { "command": "git-branch.copyRevision", "when": "false" },
        { "command": "git-branch.cherryPick", "when": "false" },
        { "command": "git-branch.checkoutRevision", "when": "false" },
        { "command": "git-branch.compareLocal", "when": "false" },
        { "command": "git-branch.reset", "when": "false" },
        { "command": "git-branch.revert", "when": "false" },
        { "command": "git-branch.undo", "when": "false" },
        { "command": "git-branch.editMessage", "when": "false" },
        { "command": "git-branch.squash", "when": "false" },
        { "command": "git-branch.drop", "when": "false" },
        { "command": "git-branch.newBranch", "when": "false" },
        { "command": "git-branch.newTag", "when": "false" },
        { "command": "git-branch.showDiff", "when": "false" },
        { "command": "git-branch.editSource", "when": "false" },
        { "command": "git-branch.openRepositoryVersion", "when": "false" },
        { "command": "git-branch.applyFiles", "when": "false" },
        { "command": "git-branch.openHistory", "when": "false" },
        { "command": "git-branch.createFrom", "when": "false" },
        { "command": "git-branch.checkoutRemote", "when": "false" },
        { "command": "git-branch.checkoutUpdate", "when": "false" },
        { "command": "git-branch.compareWithCurrent", "when": "false" },
        { "command": "git-branch.compareWith", "when": "false" },
        { "command": "git-branch.compareWorktree", "when": "false" },
        { "command": "git-branch.mergeIntoCurrent", "when": "false" },
        { "command": "git-branch.rebaseCurrent", "when": "false" },
        { "command": "git-branch.newWorktree", "when": "false" },
        { "command": "git-branch.pullMerge", "when": "false" },
        { "command": "git-branch.pullRebase", "when": "false" },
        { "command": "git-branch.copyBranchName", "when": "false" },
        { "command": "git-branch.renameBranch", "when": "false" },
        { "command": "git-branch.deleteBranch", "when": "false" },
        { "command": "git-branch.showTags", "when": "!git-branch.tagsVisible" },
        { "command": "git-branch.hideTags", "when": "git-branch.tagsVisible" }
      ]
    }
  }
}
