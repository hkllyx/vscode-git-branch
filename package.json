{
  "name": "git-branch",
  "displayName": "Git Branch",
  "description": "Branch management in Source Control: checkout, create, compare, rename, merge, rebase and delete branches.",
  "version": "1.0.0",
  "publisher": "hkllyx",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["SCM Providers"],
  "main": "./src/extension.js",
  "extensionKind": ["workspace"],
  "extensionDependencies": ["vscode.git"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/git-operations.js && node --check src/date-format.js && node --check package-vsix.js"
  },
  "contributes": {
    "commands": [
      { "command": "git-branch.refresh", "title": "Refresh", "category": "Git Branch", "icon": "$(refresh)" },
      { "command": "git-branch.create", "title": "Create", "category": "Git Branch", "icon": "$(add)" },
      { "command": "git-branch.createAndCheckout", "title": "Create and Checkout", "category": "Git Branch" },
      { "command": "git-branch.update", "title": "Update", "category": "Git Branch", "icon": "$(cloud-download)" },
      { "command": "git-branch.updateAll", "title": "Update All", "category": "Git Branch" },
      { "command": "git-branch.pull", "title": "Pull", "category": "Git Branch" },
      { "command": "git-branch.push", "title": "Push", "category": "Git Branch", "icon": "$(cloud-upload)" },
      { "command": "git-branch.checkout", "title": "Checkout", "category": "Git Branch" },
      { "command": "git-branch.compareSelected", "title": "Compare", "category": "Git Branch" },
      { "command": "git-branch.diffSelected", "title": "Show Diff", "category": "Git Branch" },
      { "command": "git-branch.compare", "title": "Compare with Current", "category": "Git Branch" },
      { "command": "git-branch.worktree", "title": "Show Diff with Working Tree", "category": "Git Branch", "icon": "$(diff)" },
      { "command": "git-branch.compareCommits", "title": "Compare Selected Commits", "category": "Git Branch" },
      { "command": "git-branch.setTracking", "title": "Set Tracking", "category": "Git Branch" },
      { "command": "git-branch.rename", "title": "Rename", "category": "Git Branch" },
      { "command": "git-branch.merge", "title": "Merge into Current", "category": "Git Branch" },
      { "command": "git-branch.rebase", "title": "Rebase Current onto Target", "category": "Git Branch" },
      { "command": "git-branch.cherryPick", "title": "Cherry-Pick to Current", "category": "Git Branch" },
      { "command": "git-branch.checkoutCommit", "title": "Checkout Commit (Detached)", "category": "Git Branch" },
      { "command": "git-branch.checkoutTag", "title": "Checkout Tag (Detached HEAD)", "category": "Git Branch" },
      { "command": "git-branch.delete", "title": "Delete", "category": "Git Branch", "icon": "$(trash)" },
      { "command": "git-branch.openDiff", "title": "Open Diff", "category": "Git Branch" },
      { "command": "git-branch.openCompareDiff", "title": "Open Diff", "category": "Git Branch", "icon": "$(diff)" },
      { "command": "git-branch.openCommitWorkingFile", "title": "Open File", "category": "Git Branch", "icon": "$(go-to-file)" },
      { "command": "git-branch.openWorktreeFile", "title": "Open File", "category": "Git Branch", "icon": "$(go-to-file)" },
      { "command": "git-branch.openWorktreeDiff", "title": "Open Diff", "category": "Git Branch", "icon": "$(diff)" },
      { "command": "git-branch.openFolderDiffs", "title": "Open All Diffs in Folder", "category": "Git Branch" },
      { "command": "git-branch.openRevisionLeft", "title": "Open File at Left Revision", "category": "Git Branch" },
      { "command": "git-branch.openRevisionRight", "title": "Open File at Right Revision", "category": "Git Branch" },
      { "command": "git-branch.copyCommitHash", "title": "Copy Short Hash", "category": "Git Branch", "icon": "$(copy)" },
      { "command": "git-branch.copyBranchName", "title": "Copy Branch Name", "category": "Git Branch" },
      { "command": "git-branch.copyText", "title": "Copy", "category": "Git Branch" },
      { "command": "git-branch.copyRepository", "title": "Copy Repository Name or Path", "category": "Git Branch" },
      { "command": "git-branch.copyComparison", "title": "Copy Comparison Name or Refs", "category": "Git Branch" },
      { "command": "git-branch.copyNodeName", "title": "Copy Name", "category": "Git Branch" },
      { "command": "git-branch.copyBranchList", "title": "Copy List", "category": "Git Branch" },
      { "command": "git-branch.copyBranchRef", "title": "Copy Full Ref", "category": "Git Branch" },
      { "command": "git-branch.copyRemoteUrl", "title": "Copy Remote URL", "category": "Git Branch" },
      { "command": "git-branch.copyPath", "title": "Copy Relative Path", "category": "Git Branch" },
      { "command": "git-branch.copyAbsolutePath", "title": "Copy Absolute Path", "category": "Git Branch" },
      { "command": "git-branch.copyCommitFullHash", "title": "Copy Full Hash", "category": "Git Branch" },
      { "command": "git-branch.copyCommitMessage", "title": "Copy Commit Message", "category": "Git Branch" },
      { "command": "git-branch.openRepositoryOnRemote", "title": "Open Repository on Remote", "category": "Git Branch" },
      { "command": "git-branch.openOnRemote", "title": "Open on Remote", "category": "Git Branch", "icon": "$(link-external)" },
      { "command": "git-branch.openCommitOnRemote", "title": "Open Commit on Remote", "category": "Git Branch" },
      { "command": "git-branch.fetch", "title": "Fetch", "category": "Git Branch" },
      { "command": "git-branch.fetchAll", "title": "Fetch All", "category": "Git Branch", "icon": "$(cloud-download)" },
      { "command": "git-branch.fetchTags", "title": "Fetch Tags", "category": "Git Branch" },
      { "command": "git-branch.prune", "title": "Prune Stale Remote Refs", "category": "Git Branch" },
      { "command": "git-branch.removeRemote", "title": "Remove Remote", "category": "Git Branch" },
      { "command": "git-branch.pushAllTags", "title": "Push All Tags", "category": "Git Branch" },
      { "command": "git-branch.pushTag", "title": "Push Tag", "category": "Git Branch", "icon": "$(cloud-upload)" },
      { "command": "git-branch.createTag", "title": "Create Tag", "category": "Git Branch" },
      { "command": "git-branch.deleteTag", "title": "Delete Tag", "category": "Git Branch", "icon": "$(trash)" },
      { "command": "git-branch.deleteRemoteTag", "title": "Delete Remote Tag", "category": "Git Branch" },
      { "command": "git-branch.refreshAllComparisons", "title": "Refresh All Comparisons", "category": "Git Branch" },
      { "command": "git-branch.closeAllComparisons", "title": "Close All Comparisons", "category": "Git Branch" },
      { "command": "git-branch.groupSortName", "title": "Sort by Name", "category": "Git Branch" },
      { "command": "git-branch.groupSortDate", "title": "Sort by Last Commit", "category": "Git Branch" },
      { "command": "git-branch.groupSortOpened", "title": "Sort by Opened Order", "category": "Git Branch" },
      { "command": "git-branch.groupSortName.current", "title": "\u2713 Sort by Name", "category": "Git Branch" },
      { "command": "git-branch.groupSortDate.current", "title": "\u2713 Sort by Last Commit", "category": "Git Branch" },
      { "command": "git-branch.groupSortOpened.current", "title": "\u2713 Sort by Opened Order", "category": "Git Branch" },
      { "command": "git-branch.refreshCompare", "title": "Refresh Compare", "category": "Git Branch", "icon": "$(refresh)" },
      { "command": "git-branch.swapCompare", "title": "Swap Comparison", "category": "Git Branch", "icon": "$(arrow-swap)" },
      { "command": "git-branch.closeCompare", "title": "Close Compare", "category": "Git Branch", "icon": "$(close)" },
      { "command": "git-branch.refreshWorktree", "title": "Refresh Diff", "category": "Git Branch", "icon": "$(refresh)" },
      { "command": "git-branch.swapWorktree", "title": "Swap Comparison", "category": "Git Branch", "icon": "$(arrow-swap)" },
      { "command": "git-branch.closeWorktree", "title": "Close Diff", "category": "Git Branch", "icon": "$(close)" },
      { "command": "git-branch.diffList", "title": "View as List", "category": "Git Branch" },
      { "command": "git-branch.diffTree", "title": "View as Tree", "category": "Git Branch" },
      { "command": "git-branch.diffSortName", "title": "Sort by Name", "category": "Git Branch" },
      { "command": "git-branch.diffSortPath", "title": "Sort by Path", "category": "Git Branch" },
      { "command": "git-branch.diffSortStatus", "title": "Sort by Status", "category": "Git Branch" },
      { "command": "git-branch.diffList.current", "title": "\u2713 View as List", "category": "Git Branch" },
      { "command": "git-branch.diffTree.current", "title": "\u2713 View as Tree", "category": "Git Branch" },
      { "command": "git-branch.diffSortName.current", "title": "\u2713 Sort by Name", "category": "Git Branch" },
      { "command": "git-branch.diffSortPath.current", "title": "\u2713 Sort by Path", "category": "Git Branch" },
      { "command": "git-branch.diffSortStatus.current", "title": "\u2713 Sort by Status", "category": "Git Branch" }
    ],
    "keybindings": [
      { "command": "git-branch.rename", "key": "f2", "when": "focusedView == git-branch.branches && listFocus && !inputFocus && git-branch.singleLocal" }
    ],
    "submenus": [
      { "id": "git-branch.diffMore", "label": "More Actions", "icon": "$(ellipsis)" },
      { "id": "git-branch.copy", "label": "Copy" },
      { "id": "git-branch.sortLocal", "label": "Sort" },
      { "id": "git-branch.sortRemote", "label": "Sort" },
      { "id": "git-branch.sortTags", "label": "Sort" },
      { "id": "git-branch.sortCompare", "label": "Sort" }
    ],
    "views": {
      "scm": [
        { "id": "git-branch.branches", "name": "Branches" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "git-branch.refresh", "when": "view == git-branch.branches", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "git-branch.refresh", "when": "view == git-branch.branches && viewItem == gb-root", "group": "inline@1" },
        { "command": "git-branch.fetchAll", "when": "view == git-branch.branches && viewItem == gb-root", "group": "inline@2" },
        { "command": "git-branch.openRepositoryOnRemote", "when": "view == git-branch.branches && viewItem == gb-root", "group": "0_open@1" },
        { "command": "git-branch.refresh", "when": "view == git-branch.branches && viewItem == gb-root", "group": "1_actions@1" },
        { "command": "git-branch.fetchAll", "when": "view == git-branch.branches && viewItem == gb-root", "group": "1_actions@2" },
        { "submenu": "git-branch.copy", "when": "view == git-branch.branches && viewItem == gb-root", "group": "5_copy@1" },

        { "command": "git-branch.create", "when": "view == git-branch.branches && viewItem =~ /^gb-category-local/", "group": "1_actions@1" },
        { "command": "git-branch.updateAll", "when": "view == git-branch.branches && viewItem =~ /^gb-category-local/", "group": "1_actions@2" },
        { "submenu": "git-branch.sortLocal", "when": "view == git-branch.branches && viewItem =~ /^gb-category-local/", "group": "4_branch@1" },

        { "command": "git-branch.fetchAll", "when": "view == git-branch.branches && viewItem =~ /^gb-category-remote/", "group": "1_actions@1" },
        { "submenu": "git-branch.sortRemote", "when": "view == git-branch.branches && viewItem =~ /^gb-category-remote/", "group": "4_branch@1" },

        { "command": "git-branch.createTag", "when": "view == git-branch.branches && viewItem =~ /^gb-category-tags/", "group": "1_actions@1" },
        { "command": "git-branch.fetchTags", "when": "view == git-branch.branches && viewItem =~ /^gb-category-tags/", "group": "1_actions@2" },
        { "command": "git-branch.pushAllTags", "when": "view == git-branch.branches && viewItem =~ /^gb-category-tags/", "group": "4_branch@1" },
        { "submenu": "git-branch.sortTags", "when": "view == git-branch.branches && viewItem =~ /^gb-category-tags/", "group": "4_branch@2" },

        { "command": "git-branch.refreshAllComparisons", "when": "view == git-branch.branches && viewItem =~ /^gb-comparisons-group/", "group": "1_actions@1" },
        { "command": "git-branch.closeAllComparisons", "when": "view == git-branch.branches && viewItem =~ /^gb-comparisons-group/", "group": "1_actions@2" },
        { "submenu": "git-branch.sortCompare", "when": "view == git-branch.branches && viewItem =~ /^gb-comparisons-group/", "group": "4_branch@1" },

        { "command": "git-branch.openOnRemote", "when": "view == git-branch.branches && viewItem == gb-remote-group", "group": "0_open@1" },
        { "command": "git-branch.fetch", "when": "view == git-branch.branches && viewItem == gb-remote-group", "group": "1_actions@1" },
        { "command": "git-branch.prune", "when": "view == git-branch.branches && viewItem == gb-remote-group", "group": "1_actions@2" },
        { "command": "git-branch.removeRemote", "when": "view == git-branch.branches && viewItem == gb-remote-group", "group": "4_branch@1" },
        { "command": "git-branch.copyRemoteUrl", "when": "view == git-branch.branches && viewItem == gb-remote-group", "group": "5_copy@1" },

        { "command": "git-branch.create", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current)$/", "group": "inline@1" },
        { "command": "git-branch.update", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current)$/", "group": "inline@2" },
        { "command": "git-branch.push", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current)$/", "group": "inline@3" },
        { "command": "git-branch.worktree", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current)$/", "group": "inline@4" },
        { "command": "git-branch.delete", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem == gb-local", "group": "inline@5" },
        { "command": "git-branch.openOnRemote", "when": "view == git-branch.branches && viewItem == gb-remote", "group": "inline@1" },
        { "command": "git-branch.update", "when": "view == git-branch.branches && viewItem == gb-remote", "group": "inline@2" },
        { "command": "git-branch.worktree", "when": "view == git-branch.branches && viewItem == gb-remote", "group": "inline@3" },
        { "command": "git-branch.delete", "when": "view == git-branch.branches && viewItem == gb-remote", "group": "inline@4" },
        { "command": "git-branch.pushTag", "when": "view == git-branch.branches && viewItem == gb-tag", "group": "inline@1" },
        { "command": "git-branch.worktree", "when": "view == git-branch.branches && viewItem == gb-tag", "group": "inline@2" },
        { "command": "git-branch.deleteTag", "when": "view == git-branch.branches && viewItem == gb-tag", "group": "inline@3" },
        { "command": "git-branch.copyCommitHash", "when": "view == git-branch.branches && viewItem == gb-commit", "group": "inline@1" },
        { "command": "git-branch.openCompareDiff", "when": "view == git-branch.branches && viewItem =~ /^gb-compare-file(-openable)?$/", "group": "inline@1" },
        { "command": "git-branch.openCommitWorkingFile", "when": "view == git-branch.branches && viewItem == gb-compare-file-openable", "group": "inline@2" },
        { "command": "git-branch.openWorktreeFile", "when": "view == git-branch.branches && viewItem == gb-worktree-file", "group": "inline@1" },
        { "command": "git-branch.openWorktreeDiff", "when": "view == git-branch.branches && viewItem == gb-worktree-file", "group": "inline@2" },

        { "command": "git-branch.refreshCompare", "when": "view == git-branch.branches && viewItem =~ /^gb-compare-session-/", "group": "inline@1" },
        { "command": "git-branch.swapCompare", "when": "view == git-branch.branches && viewItem =~ /^gb-compare-session-/", "group": "inline@2" },
        { "command": "git-branch.closeCompare", "when": "view == git-branch.branches && viewItem =~ /^gb-compare-session-/", "group": "inline@3" },
        { "submenu": "git-branch.diffMore", "when": "view == git-branch.branches && viewItem =~ /^gb-(diff|compare)-session-/", "group": "inline@4" },
        { "command": "git-branch.refreshWorktree", "when": "view == git-branch.branches && viewItem =~ /^gb-diff-session-/", "group": "inline@1" },
        { "command": "git-branch.swapWorktree", "when": "view == git-branch.branches && viewItem =~ /^gb-diff-session-/", "group": "inline@2" },
        { "command": "git-branch.closeWorktree", "when": "view == git-branch.branches && viewItem =~ /^gb-diff-session-/", "group": "inline@3" },

        { "command": "git-branch.openOnRemote", "when": "view == git-branch.branches && viewItem =~ /^gb-(local|remote|tag)$/", "group": "0_open@1" },
        { "command": "git-branch.openCommitOnRemote", "when": "view == git-branch.branches && viewItem == gb-commit", "group": "0_open@1" },
        { "command": "git-branch.checkout", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|remote)$/", "group": "1_actions@1" },
        { "command": "git-branch.checkoutTag", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem == gb-tag", "group": "1_actions@1" },
        { "command": "git-branch.create", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current|remote|tag)$/", "group": "1_actions@2" },
        { "command": "git-branch.createAndCheckout", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current|remote|tag)$/", "group": "1_actions@3" },
        { "command": "git-branch.update", "when": "view == git-branch.branches && viewItem =~ /^gb-(local|current|remote)$/", "group": "1_actions@4" },
        { "command": "git-branch.push", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current)$/", "group": "1_actions@5" },
        { "command": "git-branch.pull", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current)$/", "group": "1_actions@6" },
        { "command": "git-branch.pushTag", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem == gb-tag", "group": "1_actions@4" },
        { "command": "git-branch.create", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem == gb-commit", "group": "1_actions@2" },
        { "command": "git-branch.createTag", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem == gb-commit", "group": "1_actions@3" },
        { "command": "git-branch.checkoutCommit", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem == gb-commit", "group": "1_actions@4" },
        { "command": "git-branch.merge", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|remote)$/", "group": "2_merge@1" },
        { "command": "git-branch.cherryPick", "when": "view == git-branch.branches && viewItem == gb-commit", "group": "2_merge@1" },
        { "command": "git-branch.rebase", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|remote)$/", "group": "2_merge@2" },
        { "command": "git-branch.compare", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|remote|tag)$/", "group": "3_compare@1" },
        { "command": "git-branch.compareCommits", "when": "view == git-branch.branches && git-branch.multiSelection && viewItem == gb-commit", "group": "3_compare@1" },
        { "command": "git-branch.compareSelected", "when": "view == git-branch.branches && git-branch.twoBranches && viewItem =~ /^gb-(local|current|remote)$/", "group": "3_compare@1" },
        { "command": "git-branch.worktree", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current|remote|tag)$/", "group": "3_compare@2" },
        { "command": "git-branch.diffSelected", "when": "view == git-branch.branches && git-branch.twoBranches && viewItem =~ /^gb-(local|current|remote)$/", "group": "3_compare@2" },
        { "command": "git-branch.setTracking", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current)$/", "group": "4_branch@0" },
        { "command": "git-branch.rename", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem =~ /^gb-(local|current)$/", "group": "4_branch@1" },
        { "command": "git-branch.delete", "when": "view == git-branch.branches && (viewItem == gb-local || (git-branch.multiSelection && viewItem =~ /^gb-(local|current|remote)$/))", "group": "4_branch@2" },
        { "command": "git-branch.delete", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem == gb-remote", "group": "4_branch@2" },
        { "command": "git-branch.deleteTag", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem == gb-tag", "group": "4_branch@2" },
        { "command": "git-branch.deleteRemoteTag", "when": "view == git-branch.branches && !git-branch.multiSelection && viewItem == gb-tag", "group": "4_branch@3" },
        { "command": "git-branch.openRevisionLeft", "when": "view == git-branch.branches && viewItem =~ /^gb-compare-file(-openable)?$/", "group": "0_open@1" },
        { "command": "git-branch.openRevisionRight", "when": "view == git-branch.branches && viewItem =~ /^gb-compare-file(-openable)?$/", "group": "0_open@2" },
        { "command": "git-branch.openFolderDiffs", "when": "view == git-branch.branches && viewItem == gb-comparison-folder", "group": "1_actions@1" },
        { "command": "git-branch.openWorktreeFile", "when": "view == git-branch.branches && viewItem == gb-worktree-file", "group": "0_open@2" },

        { "submenu": "git-branch.copy", "when": "view == git-branch.branches && viewItem =~ /^gb-(local|current|remote|tag|commit)$/", "group": "5_copy@1" },
        { "submenu": "git-branch.copy", "when": "view == git-branch.branches && viewItem =~ /^gb-(compare-file(-openable)?|worktree-file|comparison-folder)$/", "group": "5_copy@1" },
        { "submenu": "git-branch.copy", "when": "view == git-branch.branches && viewItem =~ /^gb-(compare-session-|compare-side)/", "group": "5_copy@1" }
      ],
      "git-branch.copy": [
        { "command": "git-branch.copyRepository", "when": "viewItem == gb-root", "group": "1_copy@1" },
        { "command": "git-branch.copyBranchList", "when": "viewItem =~ /^gb-category-(local|remote|tags)/", "group": "1_copy@1" },
        { "command": "git-branch.copyNodeName", "when": "viewItem =~ /^gb-(local|current|remote|tag)$/", "group": "1_copy@1" },
        { "command": "git-branch.copyBranchRef", "when": "viewItem =~ /^gb-(local|current|remote)$/", "group": "1_copy@2" },
        { "command": "git-branch.copyRemoteUrl", "when": "viewItem == gb-remote", "group": "1_copy@3" },
        { "command": "git-branch.copyCommitHash", "when": "viewItem =~ /^gb-(local|current|tag)$/", "group": "1_copy@3" },
        { "command": "git-branch.copyCommitHash", "when": "viewItem == gb-commit", "group": "1_copy@1" },
        { "command": "git-branch.copyCommitFullHash", "when": "viewItem == gb-commit", "group": "1_copy@2" },
        { "command": "git-branch.copyCommitMessage", "when": "viewItem == gb-commit", "group": "1_copy@3" },
        { "command": "git-branch.copyPath", "when": "viewItem =~ /^gb-(compare-file|compare-file-openable|worktree-file)$/", "group": "1_copy@1" },
